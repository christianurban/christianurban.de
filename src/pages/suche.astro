---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/site';

// Den Index erzeugt Pagefind nach dem Build (npm run build). Im Dev-Server gibt es ihn nicht.
const pagefindUrl = url('/pagefind/pagefind.js');
const baseUrl = url('/');
---

<BaseLayout title="Suche" description="Volltextsuche über alle Notizen und Meinungsbeiträge.">
  <header class="search-head">
    <span class="kicker">Suche</span>
    <h1>Beiträge durchsuchen</h1>
    <form class="search-form" role="search" action={url('/suche/')} method="get">
      <label class="visually-hidden" for="search-input">Suchbegriff</label>
      <input
        id="search-input"
        name="q"
        type="search"
        placeholder="z. B. Home Assistant, Dependabot, Astro …"
        autocomplete="off"
        spellcheck="false"
        enterkeyhint="search"
      />
    </form>
    <p class="search-status" id="search-status" role="status" aria-live="polite"></p>
  </header>

  <ol class="search-results" id="search-results"></ol>

  <noscript><p class="search-status">Die Suche braucht JavaScript.</p></noscript>
</BaseLayout>

<script is:inline define:vars={{ pagefindUrl, baseUrl }}>
  const input = document.getElementById('search-input');
  const status = document.getElementById('search-status');
  const list = document.getElementById('search-results');
  let pagefind;
  let current = 0;

  const escape = (text) =>
    String(text ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);

  async function load() {
    if (pagefind) return pagefind;
    try {
      pagefind = await import(pagefindUrl);
      await pagefind.options({ baseUrl, excerptLength: 24 });
      pagefind.init();
      return pagefind;
    } catch {
      status.textContent = 'Der Suchindex ist nicht verfügbar. Er entsteht erst beim Build (npm run build).';
      return null;
    }
  }

  async function search(query) {
    const run = ++current;
    const term = query.trim();
    const params = new URLSearchParams(location.search);
    term ? params.set('q', term) : params.delete('q');
    history.replaceState(null, '', params.size ? `?${params}` : location.pathname);

    if (!term) {
      list.innerHTML = '';
      status.textContent = '';
      return;
    }

    const pf = await load();
    if (!pf) return;
    const result = await pf.debouncedSearch(term, {}, 200);
    if (result === null || run !== current) return; // von einer neueren Eingabe überholt

    const data = await Promise.all(result.results.slice(0, 20).map((r) => r.data()));
    if (run !== current) return;

    const count = result.results.length;
    status.textContent =
      count === 0 ? `Keine Treffer für „${term}“.` : `${count} Treffer für „${term}“`;

    // Pagefind markiert Treffer im Auszug selbst mit <mark>, der übrige Text ist bereits maskiert
    list.innerHTML = data
      .map(
        (d) => `
        <li>
          <a class="card" href="${escape(d.url)}">
            <span class="kicker">${escape(d.meta.rubrik)}${d.meta.datum ? ` · ${escape(d.meta.datum)}` : ''}</span>
            <h2>${escape(d.meta.title)}</h2>
            <p>${d.excerpt}</p>
          </a>
        </li>`,
      )
      .join('');
  }

  input.addEventListener('input', () => search(input.value));
  input.closest('form').addEventListener('submit', (event) => {
    event.preventDefault();
    search(input.value);
  });
  input.addEventListener('focus', load, { once: true });

  const initial = new URLSearchParams(location.search).get('q');
  if (initial) {
    input.value = initial;
    search(initial);
  }
  input.focus();
</script>

<style>
  .search-head {
    max-width: var(--prose);
    margin-bottom: 28px;
  }

  h1 {
    margin: 12px 0 24px;
    font-size: clamp(2rem, 6vw, 3.25rem);
    font-weight: 700;
  }

  input {
    width: 100%;
    padding: 14px 18px;
    font: inherit;
    font-size: 1.05rem;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    outline: none;
    transition: border-color 0.15s, box-shadow 0.15s;
  }

  input::placeholder {
    color: var(--muted);
  }

  input:focus-visible {
    border-color: var(--violet);
    box-shadow: var(--glow);
  }

  .search-status {
    min-height: 1.5em;
    margin: 14px 4px 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
  }

  .search-results {
    display: grid;
    gap: 14px;
    max-width: var(--prose);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .search-results :global(h2) {
    font-size: 1.2rem;
  }

  .search-results :global(p) {
    margin: 0;
    font-size: 0.93rem;
    color: var(--muted);
  }

  .search-results :global(mark) {
    padding: 0 2px;
    color: var(--text);
    background: rgba(124, 92, 255, 0.3);
    border-radius: 3px;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
