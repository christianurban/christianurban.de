---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import portrait from '../assets/christian-urban.jpg';
import PostCard from '../components/PostCard.astro';
import { PROJECTS, SECTIONS, SECTION_KEYS, SITE, getAllPosts, url } from '../lib/site';

const latest = (await getAllPosts()).slice(0, 6);
const personImage = await getImage({ src: portrait, width: 300, format: 'jpg' });

// Strukturierte Daten für Suchmaschinen
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.title,
  jobTitle: SITE.jobTitle,
  url: Astro.site?.href,
  image: new URL(personImage.src, Astro.site).href,
  sameAs: [SITE.github, SITE.linkedin],
  homeLocation: { '@type': 'Place', name: SITE.location },
  worksFor: {
    '@type': 'Organization',
    name: SITE.employer.name,
    url: SITE.employer.url,
    address: { '@type': 'PostalAddress', addressLocality: SITE.employer.location },
  },
};

const facts = [
  { label: 'Beruf', value: SITE.jobTitle },
  { label: 'Arbeitgeber', value: `${SITE.employer.name}, ${SITE.employer.location}` },
  { label: 'Schwerpunkte', value: 'KI-gestützte Entwicklung, GitHub, DevOps' },
  { label: 'Zuhause', value: SITE.location },
  { label: 'Abseits vom Code', value: 'Tennis, Joggen, Wandern, Kochen' },
  { label: 'Familie', value: 'Verheiratet, zwei Töchter und eine Berner Sennenhündin' },
];
---

<BaseLayout>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(person)} />

  <section class="hero">
    <Image
      class="portrait"
      src={portrait}
      alt="Porträt von Christian Urban: lächelnd, mit kurzem Bart, dunklem Sakko und weißem Hemd"
      width={180}
      height={180}
      densities={[1, 1.5]}
      loading="eager"
      fetchpriority="high"
    />
    <span class="kicker">Development &amp; Operations · KI · GitHub</span>
    <h1>Hi, ich bin Christian. Ich schreibe über <span class="gradient-text">Softwareentwicklung mit KI</span>.</h1>
    <p class="lede">
      Als Lead Technical Advisor for Development and Operations bei der GWS mbH in Münster beschäftige ich mich damit, wie KI, GitHub und gute
      Werkzeuge die Softwareentwicklung verändern. Hier teile ich, was ich dabei lerne.
    </p>
    <div class="actions">
      <a class="button" href={url('/notizen/')}>Zu den Notizen</a>
      <a class="button-ghost" href={SITE.github} rel="me">GitHub</a>
      <a class="button-ghost" href={SITE.linkedin} rel="me">LinkedIn</a>
    </div>
  </section>

  <section class="about" aria-labelledby="about-title">
    <div class="about-text">
      <h2 id="about-title">Über mich</h2>
      <p>
        Ich arbeite an der Schnittstelle von Entwicklung und Betrieb: Wie bauen Teams Software, die sich zuverlässig
        ausliefern und betreiben lässt – und was ändert sich, wenn KI-Assistenten wie Claude Code oder GitHub Copilot
        mitarbeiten? Auf dieser Seite sammle ich Erfahrungen aus eigenen Projekten und Experimenten.
      </p>
      <p>
        Zu Hause bin ich in Drevenack am Niederrhein. Den Ausgleich finde ich auf dem Tennisplatz, beim Laufen, auf
        Wanderungen und in der Küche – meistens zusammen mit meiner Familie und unserer Berner Sennenhündin.
      </p>
    </div>
    <dl class="facts card">
      {
        facts.map(({ label, value }) => (
          <div>
            <dt>{label}</dt>
            <dd>{value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  {
    latest.length > 0 && (
      <section aria-labelledby="latest-title">
        <div class="section-head">
          <h2 id="latest-title">Neueste Beiträge</h2>
        </div>
        <div class="card-grid">
          {latest.map((post) => <PostCard post={post} showSection />)}
        </div>
      </section>
    )
  }

  <section aria-labelledby="projects-title">
    <div class="section-head">
      <h2 id="projects-title">Projekte</h2>
    </div>
    <div class="card-grid">
      {
        PROJECTS.map((project) => (
          <a class="card" href={project.href}>
            <span class="kicker">{project.kicker}</span>
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            <div class="card-meta">
              <span>{project.label} ↗</span>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <section aria-labelledby="sections-title">
    <div class="section-head">
      <h2 id="sections-title">Rubriken</h2>
    </div>
    <div class="card-grid">
      {
        SECTION_KEYS.map((key) => (
          <a class="card" href={url(`/${key}/`)}>
            <h3>{SECTIONS[key].label}</h3>
            <p>{SECTIONS[key].description}</p>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .portrait {
    width: 112px;
    height: 112px;
    margin-bottom: 24px;
    border-radius: 50%;
    border: 2px solid var(--border);
    object-fit: cover;
  }

  .hero h1 {
    max-width: 18ch;
    margin: 14px 0 20px;
    font-size: clamp(1.9rem, 8vw, 4rem);
    font-weight: 700;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }

  .about {
    display: grid;
    gap: 28px;
    margin-top: 72px;
  }

  .about h2 {
    margin-bottom: 16px;
    font-size: 1.5rem;
  }

  .about-text p {
    max-width: 62ch;
    margin: 0 0 1em;
    color: var(--text-soft);
  }

  .facts {
    gap: 0;
    margin: 0;
    padding: 6px 22px;
  }

  .facts div {
    display: grid;
    gap: 2px;
    padding: 12px 0;
    border-bottom: 1px dashed var(--border);
  }

  .facts div:last-child {
    border-bottom: none;
  }

  .facts dt {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--cyan);
  }

  .facts dd {
    margin: 0;
    font-size: 0.95rem;
  }

  @media (min-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: 56px;
    }

    .hero > :not(.portrait) {
      grid-column: 1;
    }

    .portrait {
      grid-column: 2;
      grid-row: 1 / span 4;
      align-self: center;
      width: 180px;
      height: 180px;
      margin: 0;
    }

    .about {
      grid-template-columns: 1.4fr 1fr;
      align-items: start;
      gap: 56px;
    }
  }
</style>
