---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate } from '../lib/site';

// Einzelseiten aus src/content/seiten/, z. B. now.md → /now/
export async function getStaticPaths() {
  const pages = await getCollection('seiten');
  return pages.map((page) => ({ params: { seite: page.id }, props: { page } }));
}

const { page } = Astro.props;
const { title, description, updated, kicker } = page.data;
const { Content } = await render(page);
---

<BaseLayout title={title} description={description}>
  <article>
    <header class="page-head">
      <span class="kicker">
        {kicker} · Stand <time datetime={updated.toISOString()}>{formatDate(updated)}</time>
      </span>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .page-head {
    max-width: var(--prose);
    margin-bottom: 40px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--border);
  }

  h1 {
    margin: 12px 0 16px;
    font-size: clamp(2rem, 6vw, 3.25rem);
    font-weight: 700;
  }
</style>
