---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SECTIONS, SECTION_KEYS, formatDate, getPosts, tagUrl, url } from '../../lib/site';

export async function getStaticPaths() {
  const posts = (await Promise.all(SECTION_KEYS.map(getPosts))).flat();
  return posts.map((post) => ({ params: { section: post.collection, id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { title, description, date, updated, tags, draft } = post.data;
const section = SECTIONS[post.collection];
const { Content } = await render(post);
---

<BaseLayout title={title} description={description} type="article">
  <article data-pagefind-body data-pagefind-meta={`rubrik:${section.label}`}>
    <a class="back-link" href={url(`/${post.collection}/`)} data-pagefind-ignore>← {section.label}</a>
    <header class="article-head">
      <span class="kicker" data-pagefind-ignore>
        <time datetime={date.toISOString()} data-pagefind-meta="datum">{formatDate(date)}</time>
        {updated && <> · aktualisiert <time datetime={updated.toISOString()}>{formatDate(updated)}</time></>}
        {draft && <span class="draft"> · Entwurf</span>}
      </span>
      <h1 data-pagefind-meta="title">{title}</h1>
      <p class="lede" data-pagefind-meta="beschreibung">{description}</p>
      {tags.length > 0 && <ul class="tag-list">{tags.map((tag) => <li><a href={tagUrl(tag)}>#{tag}</a></li>)}</ul>}
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .article-head {
    max-width: var(--prose);
    margin-bottom: 40px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--border);
  }

  h1 {
    margin: 12px 0 16px;
    font-size: clamp(2rem, 6vw, 3.25rem);
    font-weight: 700;
  }

  .tag-list {
    margin-top: 20px;
  }

  .draft {
    color: var(--pink);
  }
</style>
